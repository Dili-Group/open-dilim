{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-dilim-landing",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": [
    "nodejs_compat",
    // Cho phép Worker gọi chính nó qua service binding (OpenNext dùng cho ISR/revalidate).
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}

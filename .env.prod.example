# Copy → .env.prod (KHÔNG commit). Dùng cho docker-compose.prod.yml:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build --wait
#
# File này vừa là env của container agent (env_file) vừa là nguồn interpolation cho compose.
# DATABASE_URL / REDIS_URL do compose tự set (trỏ service name) — không khai ở đây.

# --- Postgres ---
POSTGRES_USER=dilim
# BẮT BUỘC đổi: sinh bằng `openssl rand -base64 32`.
POSTGRES_PASSWORD=
POSTGRES_DB=dilim
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=256MB
PG_MEMORY=2g

# --- Redis ---
REDIS_MAXMEMORY=512mb
REDIS_MEMORY=1g

# --- Agent ---
# Để trống khi deploy qua CI: workflow Release truyền digest GHCR vào AGENT_IMAGE_REF.
# Set tay chỉ khi muốn ghim một image cụ thể trên server (vd rollback thủ công).
# AGENT_IMAGE_REF=ghcr.io/dili-group/open-dilim@sha256:...
# Bind loopback + reverse proxy (nginx/caddy) lo TLS. 0.0.0.0 = phơi thẳng ra LAN/Internet.
AGENT_BIND=127.0.0.1
AGENT_PORT=3000
AGENT_CPUS=2
AGENT_MEMORY=1g
WORKER_COUNT=4

# --- Hệ thống vận hành (operational backend) — BẮT BUỘC ---
OPERATIONAL_BASE_URL=
OPERATIONAL_SERVICE_TOKEN=

# --- API nghiệp vụ /agent/* (tra đơn, camera) — BẮT BUỘC ---
# Kèm cả tiền tố /api, vd https://api.dilisupplement.com/api
DILIM_API_URL=
SERVICE_TOKEN_AGENT_API=

# --- Kênh chat ---
# Mỗi kênh = 1 tài khoản Zalo riêng = 1 root agent riêng (xem docs/architecture/04-agent-routing.md).
# Thiếu *_AGENT_UID hoặc *_WEBHOOK_SECRET → kênh KHÔNG bật: POST /webhook/<tên kênh> trả 404.
# Thiếu *_BRIDGE_* → kênh vẫn nhận tin nhưng egress ra console (dev), không gửi được về Zalo.
# ĐỪNG đổi tên kênh đang chạy: tên nằm trong cột `channel` của user_binding/group_map/group_member.

# zalo → DealerAgent (đại lý) — kênh đang chạy thật
ZALO_AGENT_UID=
ZALO_WEBHOOK_SECRET=
ZALO_BRIDGE_URL=
ZALO_BRIDGE_SECRET=

# zalo-vanhanh → OperationsAgent (nhân viên vận hành)
ZALO_VANHANH_AGENT_UID=
ZALO_VANHANH_WEBHOOK_SECRET=
ZALO_VANHANH_BRIDGE_URL=
ZALO_VANHANH_BRIDGE_SECRET=

# zalo-sep → BossAgent (ban lãnh đạo)
ZALO_SEP_AGENT_UID=
ZALO_SEP_WEBHOOK_SECRET=
ZALO_SEP_BRIDGE_URL=
ZALO_SEP_BRIDGE_SECRET=

# zalo-canhan → PersonalAgent (trợ lý riêng, chỉ 1-1)
ZALO_CANHAN_AGENT_UID=
ZALO_CANHAN_WEBHOOK_SECRET=
ZALO_CANHAN_BRIDGE_URL=
ZALO_CANHAN_BRIDGE_SECRET=

# --- LLM ---
PROVIDER=anthropic
MODEL=claude-opus-4-8
MEMORY_MODEL=claude-haiku-4-5
EFFORT=medium
MAX_TOKENS=16000
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Dùng cho embedding trí nhớ dài hạn. Thiếu → bootstrap tắt recall (log cảnh báo, vẫn chạy).
GEMINI_API_KEY=

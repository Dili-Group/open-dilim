# Copy → .env.prod (KHÔNG commit). Dùng cho docker-compose.prod.yml:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build --wait
#
# File này vừa là env của container agent (env_file) vừa là nguồn interpolation cho compose.
# DATABASE_URL / REDIS_URL do compose tự set (trỏ service name) — không khai ở đây.

# --- Postgres ---
POSTGRES_USER=dilim
# BẮT BUỘC đổi: sinh bằng `openssl rand -base64 32`.
POSTGRES_PASSWORD=
POSTGRES_DB=dilim
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=256MB
PG_MEMORY=2g

# --- Redis ---
REDIS_MAXMEMORY=512mb
REDIS_MEMORY=1g

# --- Agent ---
IMAGE_TAG=latest
# Bind loopback + reverse proxy (nginx/caddy) lo TLS. 0.0.0.0 = phơi thẳng ra LAN/Internet.
AGENT_BIND=127.0.0.1
AGENT_PORT=3000
AGENT_CPUS=2
AGENT_MEMORY=1g
WORKER_COUNT=4

# --- Hệ thống vận hành (operational backend) — BẮT BUỘC ---
OPERATIONAL_BASE_URL=
OPERATIONAL_SERVICE_TOKEN=

# --- Kênh Zalo (optional — thiếu cả 2 thì kênh zalo tắt) ---
ZALO_AGENT_UID=
ZALO_WEBHOOK_SECRET=
# Egress qua bridge HTTP nội bộ (optional).
ZALO_BRIDGE_URL=
ZALO_BRIDGE_SECRET=

# --- LLM ---
PROVIDER=anthropic
MODEL=claude-opus-4-8
MEMORY_MODEL=claude-haiku-4-5
EFFORT=medium
MAX_TOKENS=16000
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Dùng cho embedding trí nhớ dài hạn. Thiếu → bootstrap tắt recall (log cảnh báo, vẫn chạy).
GEMINI_API_KEY=

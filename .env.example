# Copy → .env. docker-compose + app đọc chung.

# --- Postgres (memory dài hạn + scheduler_jobs) ---
POSTGRES_USER=dilim
POSTGRES_PASSWORD=dilim
POSTGRES_DB=dilim
DATABASE_URL=postgres://dilim:dilim@localhost:5432/dilim
POSTGRES_PORT=5432


# --- Redis (broker, short-term, order-lock, ZSET, leader-lock) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- HTTP gateway (ingress webhook) ---
# Optional — mặc định 3000.
PORT=3000

# --- API hệ vận hành (agent-session + /agent/*) — BẮT BUỘC ---
# Kèm cả tiền tố /api, vd https://api.dilisupplement.com/api
DILIM_API_URL=http://localhost:8080/api
SERVICE_TOKEN_AGENT_API=

# --- Kênh Zalo (optional — thiếu cả 2 thì kênh đó tắt: webhook 404, không agent nào phục vụ) ---
# Mỗi tiền tố = 1 tài khoản Zalo = 1 root agent (agents/router.ts).
ZALO_AGENT_UID=
ZALO_WEBHOOK_SECRET=
# Kho — nhóm nhận mã vận đơn hàng hoàn (root agent `warehouse`).
ZALO_KHO_AGENT_UID=
ZALO_KHO_WEBHOOK_SECRET=
ZALO_KHO_BRIDGE_URL=
ZALO_KHO_BRIDGE_SECRET=

# --- LLM ---
PROVIDER=anthropic
# Model ID gửi thẳng cho API — KHÔNG kèm hậu tố kiểu [1m] (Claude Code dùng, API 404).
MODEL=claude-opus-4-8
# Con nhẹ cho việc tóm-rút ghi nhớ (distill + rolling summary). Optional — mặc định = MODEL.
# Nên đặt model rẻ/nhanh (vd claude-haiku-4-5) vì chạy ngầm sau mỗi turn, tần suất cao.
MEMORY_MODEL=claude-haiku-4-5
EFFORT=medium
# Trần output token/lần gọi (optional, mặc định 16000).
MAX_TOKENS=16000
ANTHROPIC_API_KEY=
# Optional — endpoint Anthropic-compatible thay api.anthropic.com (gateway/proxy chạy model khác).
# Bỏ trống = gọi thẳng Anthropic.
ANTHROPIC_BASE_URL=
GEMINI_API_KEY=

# --- Đọc ảnh đính kèm (tool xem_anh) ---
# Model đọc ảnh (optional, mặc định gemini-3.1-flash-lite). Luôn chạy Gemini, không theo PROVIDER.
VISION_MODEL=gemini-3.1-flash-lite
# Host CDN được phép TẢI ảnh, ngăn bằng dấu phẩy. Khớp cả subdomain (cdn.dili.vn ⊃ img.cdn.dili.vn).
# BẮT BUỘC nếu muốn đọc ảnh: bỏ trống = tắt hẳn (link ảnh đến từ webhook, tải bừa là mở đường SSRF).
CDN_ALLOWED_HOSTS=

# --- Worker pool (optional) ---
WORKER_COUNT=4
# Trần thời gian một lượt, ms (optional, mặc định 20000). Quá hạn → abort → lượt tính là hỏng,
# broker giao lại (tối đa 3 lần) rồi đẩy DLQ. Nới lên nếu agent hay chạy chuỗi tool dài.
TURN_TIMEOUT_MS=20000

# --- Trần chi phí LLM theo phòng/ngày (optional) ---
# Trần khai bằng VND THEO AGENT ở src/usage/budget.ts (policy, không phải env). Ở đây chỉ hai thứ
# thật sự đổi theo môi trường:
#
# Tỉ giá quy trần VND → USD của bảng giá (mặc định 26000). Xấp xỉ là đủ — nó chỉ dịch trần vài %.
USD_VND_RATE=26000
# false = CHỈ ĐO và ghi sổ, không chặn lượt nào (shadow mode). Mặc định false có chủ đích: bật
# chặn bằng số đoán rồi khoá nhầm nhóm đại lý đang đặt hàng thì đắt hơn tiền LLM tiết kiệm được.
# Chạy đo vài ngày, xem bảng llm_usage_log, chốt trần bằng số thật rồi mới bật true.
ENFORCE_BUDGET=false

# --- Scheduler / cron (optional) ---
# Nhịp quét bảng scheduler_jobs, ms (mặc định 30000). Lịch nhỏ nhất của cron là phút.
SCHEDULER_TICK_MS=30000

# --- Phát thông báo cho TOÀN BỘ đại lý (kho báo hết hàng) ---
# user_id hệ vận hành của người DUY NHẤT được duyệt phát tin. Quy tắc cứng: mọi thông báo tới
# toàn bộ đại lý phải qua người này gật (/duyet-thongbao) thì hệ thống mới gửi.
# Là user_id, KHÔNG phải senderId Zalo (đổi thiết bị là mất) và không phải role_slug.
# Bỏ trống = KHÔNG ai phát được thông báo nào (fail-closed) — không phải "ai cũng phát được".
# Người này phải đã chạy /ketnoi-hethong, nếu không hệ thống không có đường gửi yêu cầu duyệt.
ANNOUNCE_APPROVER_USER_ID=

# --- Sentry (optional) — bỏ trống SENTRY_DSN = tắt báo lỗi từ xa ---
# DSN không phải secret (chỉ cho phép GỬI event), nhưng vẫn để trong .env cho gọn.
SENTRY_DSN=
# Nhãn môi trường trên Sentry (mặc định NODE_ENV, không có thì "development").
SENTRY_ENVIRONMENT=development
# Phiên bản để map stacktrace (optional, vd git sha).
SENTRY_RELEASE=
# Tỉ lệ lấy mẫu trace 0..1 (mặc định 0 = chỉ gửi lỗi, không gửi trace).
SENTRY_TRACES_SAMPLE_RATE=0

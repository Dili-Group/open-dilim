# Copy → .env. docker-compose + app đọc chung.

# --- Postgres (memory dài hạn + scheduler_jobs) ---
POSTGRES_USER=dilim
POSTGRES_PASSWORD=dilim
POSTGRES_DB=dilim
DATABASE_URL=postgres://dilim:dilim@localhost:5432/dilim
POSTGRES_PORT=5432


# --- Redis (broker, short-term, order-lock, ZSET, leader-lock) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- HTTP gateway (ingress webhook) ---
# Optional — mặc định 3000.
PORT=3000

# --- Hệ thống vận hành (operational backend) — BẮT BUỘC ---
OPERATIONAL_BASE_URL=http://localhost:8080
OPERATIONAL_SERVICE_TOKEN=

# --- Kênh Zalo (optional — thiếu cả 2 thì kênh zalo tắt) ---
ZALO_AGENT_UID=
ZALO_WEBHOOK_SECRET=

# --- LLM ---
PROVIDER=anthropic
# Model ID gửi thẳng cho API — KHÔNG kèm hậu tố kiểu [1m] (Claude Code dùng, API 404).
MODEL=claude-opus-4-8
# Con nhẹ cho việc tóm-rút ghi nhớ (distill + rolling summary). Optional — mặc định = MODEL.
# Nên đặt model rẻ/nhanh (vd claude-haiku-4-5) vì chạy ngầm sau mỗi turn, tần suất cao.
MEMORY_MODEL=claude-haiku-4-5
EFFORT=medium
# Trần output token/lần gọi (optional, mặc định 16000).
MAX_TOKENS=16000
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Worker pool (optional) ---
WORKER_COUNT=4

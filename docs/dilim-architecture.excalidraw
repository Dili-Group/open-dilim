    {
      "type": "text",
      "id": "mem_long_t",
      "x": 1686.97265625,
      "y": 1384.375,
      "width": 406.0546875,
      "height": 41.25,
      "text": "DÀI HẠN (persistent) — Postgres + pgvector\nfact đã chưng cất (KHÔNG log thô), embed gemini-embedding-001\nscope: (customer_id, channel, conversation_id) • semantic top-K",
      "originalText": "DÀI HẠN (persistent) — Postgres + pgvector\nfact đã chưng cất (KHÔNG log thô), embed gemini-embedding-001\nscope: (customer_id, channel, conversation_id) • semantic top-K",

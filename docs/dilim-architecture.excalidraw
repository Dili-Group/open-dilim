    {
      "type": "text",
      "id": "cron_code",
      "x": 2300,
      "y": 2128,
      "width": 1140,
      "height": 122,
      "text": "Envelope {\n  msgId: `cron:{jobId}:{scheduledTs}`,   // idempotent — chống double-fire\n  senderId: 'system:cron',  source: 'cron',  addressedToAgent: true,\n  agentType: job.agentType,   // validate whitelist NHƯ message thường\n  identity:  job.identity,    // auth gate NHƯ thường — KHÔNG \"quyền root\"\n  conversationId: job.target  // output có đích rõ (staff channel / phòng)\n}",
      "originalText": "Envelope {\n  msgId: `cron:{jobId}:{scheduledTs}`,   // idempotent — chống double-fire\n  senderId: 'system:cron',  source: 'cron',  addressedToAgent: true,\n  agentType: job.agentType,   // validate whitelist NHƯ message thường\n  identity:  job.identity,    // auth gate NHƯ thường — KHÔNG \"quyền root\"\n  conversationId: job.target  // output có đích rõ (staff channel / phòng)\n}",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,

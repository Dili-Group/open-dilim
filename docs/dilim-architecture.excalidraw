    {
      "type": "text",
      "id": "cmd_code",
      "x": 129.991015625,
      "y": 1690,
      "width": 601.7578125,
      "height": 146.25,
      "text": "flash command — gán role đại lý (nhân viên gõ trong group G)\n\n/ketnoi-daily @A\n  1. verify sender = nhân viên (user_binding active)   // guest/đại lý → reject\n  2. lấy uid A từ MENTION ENTITY (uid, offset)         // KHÔNG regex tên\n  3. validate A chưa phải nhân viên\n  4. upsert group_member(G, A, role=dai_ly, assigned_by=user_id)\n\n/huy-ketnoi @A  → set group_member.revoked_at",
      "originalText": "flash command — gán role đại lý (nhân viên gõ trong group G)\n\n/ketnoi-daily @A\n  1. verify sender = nhân viên (user_binding active)   // guest/đại lý → reject\n  2. lấy uid A từ MENTION ENTITY (uid, offset)         // KHÔNG regex tên\n  3. validate A chưa phải nhân viên\n  4. upsert group_member(G, A, role=dai_ly, assigned_by=user_id)\n\n/huy-ketnoi @A  → set group_member.revoked_at",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 300043,

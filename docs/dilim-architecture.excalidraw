      "autoResize": true
    },
    {
      "type": "text",
      "id": "mem_budget",
      "x": 1090,
      "y": 1780,
      "width": 708.3984375,
      "height": 32.5,
      "text": "Budget 1 lượt: short-term buffer (ưu tiên 1) + long-term recall (ưu tiên 2, token cap riêng).\nHistory KHÔNG bị cắt để nhường memory. Ngắn hạn thắng dài hạn khi tràn.",
      "originalText": "Budget 1 lượt: short-term buffer (ưu tiên 1) + long-term recall (ưu tiên 2, token cap riêng).\nHistory KHÔNG bị cắt để nhường memory. Ngắn hạn thắng dài hạn khi tràn.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e40af",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,

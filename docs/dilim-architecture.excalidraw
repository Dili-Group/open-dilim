      "x": 128,
      "y": 798,
      "width": 530,
      "height": 155,
      "text": "Envelope {\n  msgId, conversationId,   // phòng: direct | group\n  senderId,                // người gửi msg NÀY\n  isGroup, addressedToAgent,\n  agentType,   // ROUTING HINT — không phải quyền\n  identity,    // backend inject → nguồn sự thật QUYỀN\n  channel, payload, meta\n}",

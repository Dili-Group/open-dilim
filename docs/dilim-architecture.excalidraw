    {
      "type": "text",
      "id": "sql_code",
      "x": 1110,
      "y": 1538,
      "width": 1040,
      "height": 122,
      "text": "-- read path: embed câu hỏi → semantic search top-K, partition CỨNG theo PHÒNG\nCREATE INDEX ON memory USING hnsw (embedding vector_cosine_ops);   -- dim 1536\n\nSELECT text, ts FROM memory\n WHERE customer_id = $1 AND channel = $2 AND conversation_id = $3\n ORDER BY embedding <=> $4      -- cosine, top-K liên quan\n LIMIT 8;",
      "originalText": "-- read path: embed câu hỏi → semantic search top-K, partition CỨNG theo PHÒNG\nCREATE INDEX ON memory USING hnsw (embedding vector_cosine_ops);   -- dim 1536\n\nSELECT text, ts FROM memory\n WHERE customer_id = $1 AND channel = $2 AND conversation_id = $3\n ORDER BY embedding <=> $4      -- cosine, top-K liên quan\n LIMIT 8;",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 300061,
      "version": 4,
      "versionNonce": 1845630191,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": [],
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.25,
